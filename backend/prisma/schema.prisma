// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String     @id @default(uuid())
  nome      String
  email     String     @unique
  senha     String     
  cpf       String?    @unique
  telefone  String?
  enderecos Endereco[] 
  pedidos   Pedido[]   
}

model Endereco {
  id            Int      @id @default(autoincrement())
  identificacao String   
  rua           String
  numero        String
  bairro        String
  cidade        String
  uf            String
  cep           String
  padrao        Boolean  @default(false)
  usuarioId     String   
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
}

model Produto {
  id        String        @id
  nome      String
  preco     Float
  estoque   Int
  imagem    String
  itens     ItemPedido[]  
}

model Pedido {
  id              String       @id @default(uuid())
  numero_pedido   Int          @unique 
  total           Float
  status          String       @default("AGUARDANDO_PAGAMENTO") 
  metodoPagamento String       
  dataCriacao     DateTime     @default(now())
  usuarioId       String
  usuario         Usuario      @relation(fields: [usuarioId], references: [id])
  itens           ItemPedido[] 
}

model ItemPedido {
  id             Int     @id @default(autoincrement())
  quantidade     Int
  precoNoMomento Float   
  pedidoId       String
  pedido         Pedido  @relation(fields: [pedidoId], references: [id])
  produtoId      String
  produto        Produto @relation(fields: [produtoId], references: [id])
}